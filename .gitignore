# ============================================================================
#  .gitignore —— 告诉 git "这些文件不用纳入版本管理"
#  规则：一行一个模式；以 / 结尾表示目录；* 是通配符；# 开头是注释
# ============================================================================

# ---- Python 运行产生的缓存（每次运行都会变，不该进版本库）----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---- 虚拟环境（体积大，可重建）----
.venv/
venv/
env/

# ---- 编辑器 / 系统产生的杂项 ----
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
~$*

# ---- 本机的临时产物（导出的测试 CSV、日志等）----
out.csv
wide.csv
filter_test.csv
*.tmp
*.log

# ---- Arduino 编译产物 ----
build/
*.hex
*.elf
*.eep

# ---- 测量数据（大数据，绝不进版本库；本项目数据在 D:\IV_data）----
data/
IV_data/

# 说明：项目里的 .png / .svg 插图是交付物，**不要**忽略
